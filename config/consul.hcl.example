# HashiCorp Consul - Single Node Configuration

datacenter = "dc1"
node_name  = "consul-server-1"
data_dir   = "/opt/consul"

server           = true
bootstrap_expect = 1

bind_addr      = "127.0.0.1"
advertise_addr = "127.0.0.1"
client_addr    = "127.0.0.1"

ui_config {
  enabled = true
}

log_level = "INFO"
